{
  "name": "seedstream-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "A local-first torrent video player and downloader for macOS and Windows.",
  "author": "SeedStream Contributors",
  "type": "module",
  "main": "src/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "pack:mac": "electron-builder --mac zip && node scripts/create-mac-dmg.mjs && node scripts/copy-user-guide.mjs && node scripts/generate-checksums.mjs",
    "pack:win": "electron-builder --win nsis portable --x64 && node scripts/copy-user-guide.mjs && node scripts/generate-checksums.mjs"
  },
  "dependencies": {
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21"
  },
  "optionalDependencies": {
    "utp-native": "2.5.3"
  },
  "devDependencies": {
    "create-torrent": "6.1.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.seedstream.desktop",
    "productName": "SeedStream",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/utp-native/build{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "help",
        "to": "help",
        "filter": [
          "**/*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent Metadata",
        "description": "BitTorrent metadata file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
